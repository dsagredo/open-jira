generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Task {
    id          Int        @id @default(autoincrement())
    title       String
    description String?
    status      TaskStatus @default(pending)
    sprintId    Int?
    sprint      Sprint?    @relation(fields: [sprintId], references: [id])
    createdAt   DateTime   @default(now())
}

model Sprint {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    tasks     Task[]
}

enum TaskStatus {
    pending
    in_progress
    finished
}
